<button style="background-color: #28a745; color: white; padding: 10px 20px; border: none; border-radius: 5px;">
    <!-- Usamos el evento nativo de HTML y cuando ocurra, disparamos nuestro EventCallback -->
    <span @onclick="AlHacerClic">¡Haz clic aquí!</span>
</button>

@code {
    // Declaramos el parámetro de tipo EventCallback
    // Por convención, muchos le llaman "OnClick" o "OnAvisar"
    [Parameter]
    public EventCallback AlHacerClic { get; set; }
}