@page "/"

<PageTitle>Home</PageTitle>

<h3>Eventos personalizados con EventCallback</h3>

<!-- Usamos el componente hijo y conectamos su evento personalizado "OnTransmitirSegundos"
     al método local "RecibirSegundos" del componente padre -->
<BotonSegundos OnTransmitirSegundos="RecibirSegundos" />

<!-- Evaluamos si ya se recibió un valor válido (mayor o igual a 0) para mostrarlo en pantalla -->
@if (segundosRecibidos >= 0)
{
    <p class="mt-3">Segundo actual recibido del componente hijo: <strong>@segundosRecibidos Seg.</strong></p>
}

@code {
    // Variable de estado para almacenar el valor numérico que nos pasa el componente hijo
    private int segundosRecibidos = -1;

    // Método suscriptor: se ejecuta automáticamente cuando el hijo dispara el EventCallback.
    // Recibe como parámetro el entero (los segundos) enviado desde el hijo.
    private void RecibirSegundos(int segundos)
    {
        // Actualizamos la variable con el valor recibido
        segundosRecibidos = segundos;

        // Nota: Al modificar los "segundosRecibidos" aquí, Blazor renderiza automáticamente
        // la interfaz de usuario para reflejar el nuevo valor establecido en la linea de arriba.
    }
}